import MOR34.ParityCells
import MOR34.AugmentedDimension
import MOR34.FacetBridge

namespace MOR34

/-- A finite image has at most as many values as a finite classification that determines it. -/
theorem image_card_le_bucket_card {α β γ : Type*} [DecidableEq α] [DecidableEq β]
    [Fintype γ] (S : Finset α) (f : α → β) (bucket : α → γ)
    (h : ∀ i ∈ S, ∀ j ∈ S, bucket i = bucket j → f i = f j) :
    (S.image f).card ≤ Fintype.card γ := by
  classical
  let rep (v : S.image f) : α := (Finset.mem_image.mp v.property).choose
  have hr (v : S.image f) : rep v ∈ S ∧ f (rep v) = v.val :=
    (Finset.mem_image.mp v.property).choose_spec
  let g : S.image f → γ := fun v => bucket (rep v)
  have hi : Function.Injective g := by
    intro v w he
    apply Subtype.ext
    exact (hr v).2.symm.trans ((h _ (hr v).1 _ (hr w).1 he).trans (hr w).2)
  simpa using Fintype.card_le_of_injective g hi

variable {q : ℕ} {m : Fin q → ℕ}

noncomputable def varyingClassComponents (P : Model m) {ε : Parity q}
    (e : ParityExtrema P ε) (j : Fin q) : Finset (ExchangeComponent P) := by
  classical
  exact (Finset.univ.filter (fun u : Fin (m j) => e.low j ≤ u.val ∧ u.val < e.high j)).image
    (fun u => componentLabel P ⟨j,u⟩)

theorem varyingClassComponents_card (P : Model m) (hWF : WellFormed P) {ε : Parity q}
    (e : ParityExtrema P ε) (j : Fin q) : (varyingClassComponents P e j).card ≤ 3 := by
  classical
  let bucket : Fin (m j) → Fin 3 := fun u =>
    if u.val = e.low j then 0 else if u.val+1 = e.high j then 2 else 1
  change (Finset.image (fun u => componentLabel P ⟨j,u⟩) _).card ≤ 3
  apply (image_card_le_bucket_card _ _ bucket ?_).trans_eq (Fintype.card_fin 3)
  intro u hu v hv he
  obtain ⟨hul,huh⟩ := (Finset.mem_filter.mp hu).2
  obtain ⟨hvl,hvh⟩ := (Finset.mem_filter.mp hv).2
  by_cases hu0 : u.val = e.low j
  · have hv0 : v.val = e.low j := by
      by_contra hv0
      by_cases hv2 : v.val+1 = e.high j <;> simp [bucket, hu0, hv0, hv2] at he
    have huv : u = v := Fin.ext (hu0.trans hv0.symm)
    rw [huv]
  · by_cases hu2 : u.val+1 = e.high j
    · have hv2 : v.val+1 = e.high j := by
        by_contra hv2
        by_cases hv0 : v.val = e.low j <;> simp [bucket, hu0, hu2, hv0, hv2] at he
      have huv : u = v := Fin.ext (by omega)
      rw [huv]
    · have hv0 : v.val ≠ e.low j := by
        intro hv0
        simp [bucket, hu0, hu2, hv0] at he
      have hv2 : v.val+1 ≠ e.high j := by
        intro hv2
        simp [bucket, hu0, hu2, hv0, hv2] at he
      have hp : SameParity (e.lowerWitness j) (e.upperWitness j) :=
        fun k => ((e.lower_mem j).2.2 k).trans ((e.upper_mem j).2.2 k).symm
      apply (componentLabel_eq_iff_class_connected P j u v).mpr
      apply parity_interior_connected P hWF (e.lowerWitness j) (e.upperWitness j)
        (e.lower_mem j).1 (e.upper_mem j).1 (e.lower_mem j).2.1 (e.upper_mem j).2.1 hp
      · rw [e.lower_eq]; omega
      · rw [e.upper_eq]; omega
      · rw [e.lower_eq]; omega
      · rw [e.upper_eq]; omega

noncomputable def varyingComponents (P : Model m) {ε : Parity q}
    (e : ParityExtrema P ε) : Finset (ExchangeComponent P) := by
  classical
  exact Finset.univ.biUnion (varyingClassComponents P e)

theorem varyingComponents_card (P : Model m) (hWF : WellFormed P) {ε : Parity q}
    (e : ParityExtrema P ε) : (varyingComponents P e).card ≤ 3*q := by
  classical
  calc
    _ ≤ ∑ j, (varyingClassComponents P e j).card := Finset.card_biUnion_le
    _ ≤ ∑ _j : Fin q, 3 := Finset.sum_le_sum (fun j _ => varyingClassComponents_card P hWF e j)
    _ = 3*q := by simp [Nat.mul_comm]

noncomputable def parityComponentGenerators (P : Model m) {ε : Parity q}
    (e : ParityExtrema P ε) : Finset (ℝ × (ExchangeComponent P → ℝ)) := by
  classical
  exact insert (pointAugment (componentCountMap P (pointVector (prefixSet e.low))))
    ((varyingComponents P e).image (fun c => zeroAugment (unitVector c)))

theorem parityComponentGenerators_card (P : Model m) (hWF : WellFormed P) {ε : Parity q}
    (e : ParityExtrema P ε) : (parityComponentGenerators P e).card ≤ 3*q+1 := by
  classical
  exact (Finset.card_insert_le _ _).trans
    (Nat.add_le_add_right ((Finset.card_image_le).trans (varyingComponents_card P hWF e)) 1)

/-- Every quotient prefix in one parity class is generated by one anchor and at most 3q directions. -/
theorem parityComponentGenerators_span (P : Model m) {ε : Parity q}
    (e : ParityExtrema P ε) (z : Counts q) (hz : TightParity P ε z) :
    pointAugment (componentCountMap P (pointVector (prefixSet z))) ∈
      Submodule.span ℝ (↑(parityComponentGenerators P e) : Set (ℝ × (ExchangeComponent P → ℝ))) := by
  classical
  let D := Submodule.span ℝ (↑(parityComponentGenerators P e) : Set (ℝ × (ExchangeComponent P → ℝ)))
  have hb : pointAugment (componentCountMap P (pointVector (prefixSet e.low))) ∈ D :=
    Submodule.subset_span (Finset.mem_insert_self _ _)
  have hd : zeroAugment (componentCountMap P (pointVector (prefixSet z)) -
      componentCountMap P (pointVector (prefixSet e.low))) ∈ D := by
    rw [component_prefix_sum P z, component_prefix_sum P e.low, ← Finset.sum_sub_distrib, map_sum]
    apply D.sum_mem
    intro j _
    rw [← Finset.sum_sdiff_eq_sub (classPrefix_mono (m := m j) (e.bounds z hz j).1), map_sum]
    apply D.sum_mem
    intro u hu
    obtain ⟨huz,hul⟩ := Finset.mem_sdiff.mp hu
    have huz' : u.val < z j := (mem_classPrefix u).mp huz
    have hul' : e.low j ≤ u.val := by
      have hh : ¬ u.val < e.low j := by simpa using hul
      omega
    have huc : componentLabel P ⟨j,u⟩ ∈ varyingComponents P e := by
      apply Finset.mem_biUnion.mpr
      refine ⟨j, Finset.mem_univ _, Finset.mem_image.mpr ⟨u, ?_, rfl⟩⟩
      exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, hul', lt_of_lt_of_le huz' (e.bounds z hz j).2⟩
    exact Submodule.subset_span (Finset.mem_insert_of_mem
      (Finset.mem_image.mpr ⟨_, huc, rfl⟩))
  have he : pointAugment (componentCountMap P (pointVector (prefixSet z))) =
      pointAugment (componentCountMap P (pointVector (prefixSet e.low))) +
      zeroAugment (componentCountMap P (pointVector (prefixSet z)) -
        componentCountMap P (pointVector (prefixSet e.low))) := by
    ext <;> simp [pointAugment, zeroAugment]
  rw [he]
  exact D.add_mem hb hd

end MOR34
